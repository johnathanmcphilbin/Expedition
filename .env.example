# Copy to `.env` and fill in. `.env` is gitignored — never commit real values.

# ------------------------------------------------------- Public origin --
# Production only. Pins the OAuth `redirect_uri` so it matches the registered
# value even behind a TLS-terminating proxy. Leave unset in dev, where the
# request origin (http://localhost:5175) is used. No trailing slash.
# APP_ORIGIN=https://expedition.hackclub.com

# ---------------------------------------------------------------- Supabase --
# Project Settings → Data API. The service-role key bypasses RLS: it is
# server-only and must NEVER be given a PUBLIC_ prefix or reach the browser.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# -------------------------------------------------- Hack Club Auth (login) --
# OAuth client registered against https://auth.hackclub.com
# Redirect URI (dev):  http://localhost:5175/auth/callback
# Redirect URI (prod): https://expedition.hackclub.com/auth/callback
HCA_CLIENT_ID=
HCA_CLIENT_SECRET=

# ------------------------------------------- Hackatime (coding evidence) --
# OAuth client registered against https://hackatime.hackclub.com
# Redirect URI (dev):  http://localhost:5175/auth/hackatime/callback
# Redirect URI (prod): https://expedition.hackclub.com/auth/hackatime/callback
# Scopes: profile read   (never request admin)
HACKATIME_CLIENT_ID=
HACKATIME_CLIENT_SECRET=
