# ============================================
# EXPEDITION
# Environment Variables
#
# Copy to `.env` and fill in. `.env` is gitignored — never commit real values.
# Every name below is read verbatim by src/lib/server/env.ts; a var set under
# any other name is silently ignored, which is exactly how the OAuth redirect
# broke once already — keep this file in sync with env.ts, not the other way
# around.
# ============================================


# --------------------------------------------
# Hack Club Auth (login)
# --------------------------------------------

# OAuth application credentials, registered against https://auth.hackclub.com
HCA_CLIENT_ID=
HCA_CLIENT_SECRET=


# --------------------------------------------
# Hackatime (coding evidence)
# --------------------------------------------

# OAuth application credentials, registered against https://hackatime.hackclub.com
# Scopes: profile read — never request admin.
HACKATIME_CLIENT_ID=
HACKATIME_CLIENT_SECRET=


# --------------------------------------------
# Airtable (Hack Club's Unified YSWS)
# --------------------------------------------

# Personal access token, scoped to base appGcYrt3CFYab05y with
# data.records:read, data.records:write and schema.bases:read.
# Server-only — never sent to the browser. Create one at
# https://airtable.com/create/tokens
AIRTABLE_API_KEY=


# --------------------------------------------
# PostgREST (the database API)
# --------------------------------------------

# Base URL of the PostgREST app. No trailing slash. Server-only.
# Example: https://expedition-postgrest.example.com
POSTGREST_URL=

# Same raw string as PostgREST's PGRST_JWT_SECRET. 32+ characters, not JSON.
# Server-only. The app signs a short-lived JWT whose role claim is POSTGREST_DB_ROLE.
POSTGREST_JWT_SECRET=

# Role claim in that JWT, and PostgREST's db-anon-role. On Orchard set this to
# the database owner, which cannot create other roles:
#   u_ysws_expedition_expedition
# Leave unset locally after roles.sql (defaults to expedition).
# POSTGREST_DB_ROLE=

# Signs the referral cookie. Set this to the previous server secret at cutover
# so cookies already in browsers keep verifying. Falls back to POSTGREST_JWT_SECRET.
# REFERRAL_SECRET=

# Set to 1 during the cutover write freeze. GET and HEAD keep working;
# every other method returns 503. Unset (or 0) in normal operation.
# MAINTENANCE_MODE=


# --------------------------------------------
# Public origin (production only)
# --------------------------------------------

# Pins the OAuth redirect_uri so it matches what's registered even behind a
# TLS-terminating proxy, where the request's own origin can arrive wrong.
# Leave unset in dev — http://localhost:5175 is used automatically. No
# trailing slash. See docs/backend.md.
# APP_ORIGIN=https://expedition.hackclub.com


# --------------------------------------------
# Plausible (optional: visits on the admin page)
# --------------------------------------------

# Plausible → Settings → API keys → "Stats API". Server-only. Without it the
# admin page just leaves visits out.
# PLAUSIBLE_API_KEY=
# Defaults to expedition.hackclub.com; set if the Plausible site is named differently.
# PLAUSIBLE_SITE_ID=

