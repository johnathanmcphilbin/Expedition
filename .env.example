# ============================================
# EXPEDITION
# Environment Variables
# ============================================


# --------------------------------------------
# Hack Club Auth
# --------------------------------------------

# OAuth application credentials from Hack Club Auth
HCA_CLIENT_ID=
HCA_CLIENT_SECRET=

# OAuth callback
HCA_REDIRECT_URI=https://expedition.hackclub.com/auth/callback


# --------------------------------------------
# Hackatime
# --------------------------------------------

# OAuth credentials for connecting participant Hackatime accounts
HACKATIME_CLIENT_ID=
HACKATIME_CLIENT_SECRET=

# Add this if your Hackatime OAuth implementation uses a callback env variable
HACKATIME_REDIRECT_URI=https://expedition.hackclub.com/auth/hackatime/callback


# --------------------------------------------
# Supabase
# --------------------------------------------

# Your Supabase project URL
SUPABASE_URL=

# SERVER ONLY
# Never expose this in frontend code
SUPABASE_SERVICE_ROLE_KEY=


# --------------------------------------------
# Sessions
# --------------------------------------------

# Long random secret used to sign/encrypt sessions
SESSION_SECRET=


# --------------------------------------------
# Application
# --------------------------------------------

# Production site URL
APP_URL=https://expedition.hackclub.com

NODE_ENV=production